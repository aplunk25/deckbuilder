# Private bucket holding cards.json, written by the sync Lambda and read by
# the API Lambda.
resource "aws_s3_bucket" "cards" {
  bucket        = "${var.project}-${data.aws_caller_identity.current.account_id}-cards"
  force_destroy = true # contents are regenerated by the sync job
}

resource "aws_s3_bucket_public_access_block" "cards" {
  bucket                  = aws_s3_bucket.cards.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "cards" {
  bucket = aws_s3_bucket.cards.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}
